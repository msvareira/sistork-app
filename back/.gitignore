# Laravel .gitignore

# Dependencies
/vendor/
/node_modules/

# Environment files
.env
.env.local
.env.*.local
.env.backup
.env.production

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Laravel specific
/bootstrap/cache/*.php
/storage/*.key
/storage/app/*
!/storage/app/.gitkeep
!/storage/app/public/
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/public/hot
/public/storage
/public/build
/public/mix-manifest.json

# Testing
/coverage/
.phpunit.result.cache
.phpunit.cache

# Deployment
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log

# Docker
.docker/
docker-compose.override.yml

# Backup files
*.sql
*.dump
*.backup

# Cache and temporary files
/tmp/
/.tmp/
*.cache
*.log
*.pid
*.seed
*.pid.lock

# NPM/Yarn
package-lock.json
yarn.lock

# Build artifacts
/dist/
/build/
